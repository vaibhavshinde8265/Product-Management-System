<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add New Product</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>
<div class="container">
    <div class="card">
        <h2>Add New Product</h2>

        <%-- Validation message from AddProductServlet (the typed values are kept below) --%>
        <c:if test="${not empty errorMessage}">
            <div class="alert error"><c:out value="${errorMessage}"/></div>
        </c:if>

        <form action="${pageContext.request.contextPath}/addProduct" method="post">

            <label for="pid">Product ID (PID)</label>
            <!-- PID is generated by the database (AUTO_INCREMENT), so it is display only -->
            <input type="text" id="pid" value="Auto-generated" disabled>

            <label for="pname">Product Name (PNAME)</label>
            <input type="text" id="pname" name="pname" maxlength="100"
                   value="<c:out value='${pname}'/>" required>

            <label for="pprice">Product Price (PPRICE)</label>
            <input type="number" id="pprice" name="pprice" min="0" step="0.01"
                   value="<c:out value='${pprice}'/>" required>

            <label for="pqty">Product Quantity (PQTY)</label>
            <input type="number" id="pqty" name="pqty" min="0" step="1"
                   value="<c:out value='${pqty}'/>" required>

            <button type="submit" class="btn green full">New Product</button>
        </form>

        <div class="link-row">
            <a href="${pageContext.request.contextPath}/dashboard">Back to Dashboard</a>
        </div>
    </div>
</div>
</body>
</html>
